{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.14/MicrosoftTeams.schema.json",
    "manifestVersion": "1.14",
    "version": "2.0.14",
    "id": "83e15843-4af6-4b33-bacc-d11827352c3e",
    "packageName": "com.microsoft.teams.extension",
    "localizationInfo": {
        "defaultLanguageTag": "en"
    },
    "developer": {
        "name": "Aptero",
        "websiteUrl": "https://www.aptero.co",
        "privacyUrl": "https://www.aptero.co/legal/privacy.html",
        "termsOfUseUrl": "https://www.aptero.co/legal/termsofuse.html"
    },
    "icons": {
        "color": "resources/color.png",
        "outline": "resources/outline.png"
    },
    "name": {
        "short": "Aptero",
        "full": "Aptero - 3D Spaces"
    },
    "description": {
        "short": "Micro metaverse for business",
        "full": "Your events and immersive training in 3D. Create your immersive 3D rooms with your company&#x27;s DNA. Organize your meetings, events and training in a fun way remotely. Compatible with any device, personalize and broadcast your content."
    },
    "accentColor": "#FFFFFF",
    "bots": [],
    "composeExtensions": [],
    "configurableTabs": [
        {
            "configurationUrl": "https://meet.aptero.co/microsoft-settings.html?msteams=true",
            "canUpdateConfiguration": true,
            "scopes": [
                "team",
                "groupchat"
            ],
            "context": [
                "channelTab",
                "privateChatTab",
                "meetingChatTab",
                "meetingDetailsTab",
                "meetingSidePanel",
                "meetingStage"
            ]
        }
    ],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "authorization": {
        "permissions": {
            "orgWide": [],
            "resourceSpecific": [
                {
                    "name": "MeetingStage.Write.Chat",
                    "type": "Delegated"
                },
                {
                    "name": "ChannelMeetingStage.Write.Group",
                    "type": "Delegated"
                }
            ]
        }
    },
    "validDomains": [
        "*.aptero.co",
        "*.axolotis.com"
    ],
    "webApplicationInfo": {
        "id": "8cb358b6-25aa-4afc-b403-3362db42ea49",
        "resource": "api://meet.aptero.co/8cb358b6-25aa-4afc-b403-3362db42ea49"
    }
}