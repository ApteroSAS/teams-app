{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.11/MicrosoftTeams.schema.json",
    "manifestVersion": "1.11",
    "version": "1.0.0",
    "id": "{{state.fx-resource-appstudio.teamsAppId}}",
    "packageName": "com.microsoft.teams.extension",
    "developer": {
        "name": "Aptero",
        "websiteUrl": "https://www.aptero.co",
        "privacyUrl": "https://www.aptero.co/legal/privacy.html",
        "termsOfUseUrl": "https://www.aptero.co/legal/termsofuse.html"
    },
    "icons": {
        "color": "resources/color.png",
        "outline": "resources/outline.png"
    },
    "name": {
        "short": "{{config.manifest.appName.short}}",
        "full": "{{config.manifest.appName.full}}"
    },
    "description": {
        "short": "Micro metaverse for business",
        "full": "Your events and immersive training in 3D. Create your immersive 3D rooms with your company's DNA. Organize your meetings, events and training in a fun way remotely. Compatible with any device, personalize and broadcast your content."
    },
    "accentColor": "#FFFFFF",
    "bots": [],
    "composeExtensions": [],
    "configurableTabs": [
        {
            "configurationUrl": "{{{state.fx-resource-frontend-hosting.endpoint}}}/index.html#/config",
            "canUpdateConfiguration": true,
            "scopes": [
                "team",
                "groupchat"
            ],
            "context": [
              "channelTab",
              "privateChatTab",
              "meetingChatTab",
              "meetingDetailsTab",
              "meetingSidePanel",
              "meetingStage"
            ]
        }
    ],
    "staticTabs": [
        {
            "entityId": "index",
            "name": "Aptero - Personal Tab",
            "contentUrl": "{{{state.fx-resource-frontend-hosting.endpoint}}}/index.html#/perso",
            "websiteUrl": "{{{state.fx-resource-frontend-hosting.endpoint}}}/index.html#/perso",
            "scopes": [
                "personal"
            ]
        }
    ],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": ["*.ngrok.io","*.aptero.co","axolotis.com"],
    "webApplicationInfo": {
        "id": "{{state.fx-resource-aad-app-for-teams.clientId}}",
        "resource": "{{{state.fx-resource-aad-app-for-teams.applicationIdUris}}}"
    }
}